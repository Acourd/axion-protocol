{
  "schemaVersion": "1.0.0",
  "runtime": "antigravity",
  "name": "axion-protocol",
  "description": "Axion Protocol Governance and Fail-Closed Runtime Harness",
  "phases": {
    "discovery": {
      "rules": ".agents/rules",
      "workflows": ".agents/workflows"
    },
    "hooks": {
      "config": ".agents/hooks.json",
      "policy": ".agents/hooks/validate-tool-call.mjs"
    },
    "orchestration": {
      "workflows": [
        "clarify",
        "profile",
        "onboard",
        "preflight",
        "checkpoint",
        "rollback",
        "verify",
        "debug",
        "review",
        "compact",
        "attest",
        "halt",
        "unhalt"
      ],
      "tools": [
        "preflight.js",
        "structured_command.js",
        "risk_policy_compiler.js",
        "approval_ed25519.js",
        "check_ed25519.js",
        "evidence_hasher.js",
        "killswitch.js",
        "checkpoint.js",
        "context_shield.js",
        "verify_changes.js",
        "attestation.js",
        "health_check.js",
        "profile_adapter.js",
        "intent_clarifier.js"
      ]
    }
  }
}
