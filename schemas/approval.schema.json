{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:axion-protocol:schema:approval:1.0.0",
  "title": "Axion Ed25519 approval envelope",
  "type": "object",
  "required": ["approval", "algorithm", "signature"],
  "properties": {
    "approval": {
      "type": "object",
      "required": [
        "contractVersion", "approvalId", "missionId", "actorId", "keyId", "decision",
        "risk", "command", "scope", "requirementsHash", "policyHash", "rollbackHash",
        "issuedAt", "expiresAt", "nonce", "usageLimit"
      ],
      "properties": {
        "contractVersion": { "const": "1.0.0" },
        "approvalId": { "type": "string", "minLength": 1 },
        "missionId": { "type": "string", "minLength": 1 },
        "actorId": { "type": "string", "minLength": 1 },
        "keyId": { "type": "string", "pattern": "^ed25519:[a-f0-9]{64}$" },
        "decision": { "const": "APPROVE" },
        "risk": { "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
        "command": {
          "type": "object",
          "required": ["executable", "args", "cwd", "shell"],
          "properties": {
            "executable": { "type": "string", "minLength": 1 },
            "args": { "type": "array", "items": { "type": "string" } },
            "cwd": { "type": "string", "minLength": 1 },
            "shell": { "const": false }
          },
          "additionalProperties": false
        },
        "scope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "requirementsHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "rollbackHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "issuedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "nonce": { "type": "string", "pattern": "^[A-Za-z0-9_-]{32,}$" },
        "usageLimit": { "const": 1 }
      },
      "additionalProperties": false
    },
    "algorithm": { "const": "Ed25519" },
    "signature": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
