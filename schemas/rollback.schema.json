{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:axion-protocol:schema:rollback:0.1.0",
  "title": "Axion rollback",
  "allOf": [
    {"$ref": "urn:axion-protocol:schema:common:0.1.0#/$defs/metadata"},
    {
      "type": "object",
      "required": ["rollback_id", "target_action", "available", "procedure", "verification", "tested"],
      "properties": {
        "rollback_id": {"type": "string", "pattern": "^AX-RBK-[0-9]{4,}$"},
        "target_action": {"type": "string", "minLength": 1},
        "available": {"type": "boolean"},
        "procedure": {"type": "array", "items": {"type": "string"}},
        "verification": {"type": "array", "items": {"type": "string"}},
        "tested": {"type": "boolean"},
        "last_tested_at": {"type": ["string", "null"], "format": "date-time"}
      }
    }
  ],
  "unevaluatedProperties": false
}
