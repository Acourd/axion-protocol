{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:axion-protocol:schema:runtime:0.1.0",
  "title": "Axion runtime",
  "allOf": [
    {"$ref": "urn:axion-protocol:schema:common:0.1.0#/$defs/metadata"},
    {
      "type": "object",
      "required": ["runtime_id", "environment", "runtime_version", "compatibility", "tests", "limitations"],
      "properties": {
        "runtime_id": {"type": "string", "pattern": "^AX-RT-[0-9]{4,}$"},
        "environment": {"type": "string", "minLength": 1},
        "runtime_version": {"type": "string", "minLength": 1},
        "compatibility": {"enum": ["OBSERVED", "TESTED", "EXPERIMENTAL", "SUPPORTED", "UNSUPPORTED", "UNKNOWN"]},
        "tests": {"type": "array", "items": {"type": "string"}},
        "limitations": {"type": "array", "items": {"type": "string"}},
        "support_owner": {"type": ["string", "null"]}
      }
    }
  ],
  "unevaluatedProperties": false
}
