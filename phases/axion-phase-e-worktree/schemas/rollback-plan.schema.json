{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axion.local/schemas/rollback-plan.schema.json",
  "title": "Axion rollback plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion", "planId", "missionId", "strategy", "snapshotDigest", "steps", "verification"
  ],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "planId": { "type": "string", "minLength": 1 },
    "missionId": { "type": "string", "minLength": 1 },
    "strategy": { "type": "string", "minLength": 1 },
    "snapshotDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "steps": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "verification": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
