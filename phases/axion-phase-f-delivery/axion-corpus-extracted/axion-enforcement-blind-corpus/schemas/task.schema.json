{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:axion-protocol:schema:task:0.1.0",
  "title": "Axion task",
  "allOf": [
    {
      "$ref": "urn:axion-protocol:schema:common:0.1.0#/$defs/metadata"
    },
    {
      "type": "object",
      "required": ["task_id", "objective", "priority", "resources", "routing", "gates"],
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^AX-TASK-[0-9]{4,}$"
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "enum": ["low", "normal", "high", "critical"]
        },
        "resources": {
          "type": "object",
          "required": ["models", "tools", "skills"],
          "properties": {
            "models": {"type": "array", "items": {"type": "string"}},
            "tools": {"type": "array", "items": {"type": "string"}},
            "skills": {"type": "array", "items": {"type": "string"}},
            "time_budget": {"type": ["number", "null"], "minimum": 0},
            "context_budget": {"type": ["integer", "null"], "minimum": 0}
          },
          "additionalProperties": false
        },
        "routing": {
          "type": "object",
          "required": ["selected_executor", "reason", "alternatives_rejected"],
          "properties": {
            "selected_executor": {"type": "string"},
            "reason": {"type": "string"},
            "alternatives_rejected": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": false
        },
        "gates": {
          "type": "object",
          "required": ["human_approval_required", "rollback_required", "independent_audit_required"],
          "properties": {
            "human_approval_required": {"type": "boolean"},
            "rollback_required": {"type": "boolean"},
            "independent_audit_required": {"type": "boolean"}
          },
          "additionalProperties": false
        },
        "evidence": {
          "type": "object",
          "required": ["inputs", "outputs", "logs", "hashes"],
          "properties": {
            "inputs": {"type": "array", "items": {"type": "string"}},
            "outputs": {"type": "array", "items": {"type": "string"}},
            "logs": {"type": "array", "items": {"type": "string"}},
            "hashes": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": false
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
