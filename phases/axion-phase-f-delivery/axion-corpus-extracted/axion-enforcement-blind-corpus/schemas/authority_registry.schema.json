{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:axion-protocol:schema:authority-registry:1.0.0",
  "title": "Axion trusted public authority registry",
  "type": "object",
  "required": ["version", "authorities"],
  "properties": {
    "version": { "const": "1.0.0" },
    "authorities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["keyId", "actorId", "roles", "status", "expiresAt", "publicKeyPem"],
        "properties": {
          "keyId": { "type": "string", "pattern": "^ed25519:[a-f0-9]{64}$" },
          "actorId": { "type": "string", "minLength": 1 },
          "roles": { "type": "array", "items": { "enum": ["HUMAN_AUTHORITY", "INDEPENDENT_AUDITOR"] } },
          "status": { "enum": ["TRUSTED", "REVOKED", "EXPIRED", "UNKNOWN"] },
          "expiresAt": { "type": "string", "format": "date-time" },
          "publicKeyPem": { "type": "string", "pattern": "^-----BEGIN PUBLIC KEY-----" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
