+  const ck = K.signCheck(m, 'аlice', k2, 'charlie', K.hashCanonical(ap.approval));
+  const r = K.executeHybridWorkflow(K.payload(m, ap, ck), {
+    registryPath, approvalConsumptionDir: ws.consumptionDir,
