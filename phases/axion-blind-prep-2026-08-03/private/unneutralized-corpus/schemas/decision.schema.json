{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:axion-protocol:schema:decision:0.1.0",
  "title": "Axion decision",
  "allOf": [
    {"$ref": "urn:axion-protocol:schema:common:0.1.0#/$defs/metadata"},
    {
      "type": "object",
      "required": ["decision_id", "question", "options", "selected_option", "rationale"],
      "properties": {
        "decision_id": {"type": "string", "pattern": "^AX-DEC-[0-9]{4,}$"},
        "question": {"type": "string", "minLength": 1},
        "options": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "selected_option": {"type": ["string", "null"]},
        "rationale": {"type": "string"},
        "authority_role": {"type": "string", "default": "Human Authority"}
      }
    }
  ],
  "unevaluatedProperties": false
}
