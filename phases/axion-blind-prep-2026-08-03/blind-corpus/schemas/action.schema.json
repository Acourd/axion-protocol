{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:axion-protocol:schema:action:0.1.0",
  "title": "Axion action",
  "allOf": [
    {"$ref": "urn:axion-protocol:schema:common:0.1.0#/$defs/metadata"},
    {
      "type": "object",
      "required": ["action_id", "objective", "executor", "tool", "inputs", "expected_outputs", "rollback"],
      "properties": {
        "action_id": {"type": "string", "pattern": "^AX-ACT-[0-9]{4,}$"},
        "objective": {"type": "string", "minLength": 1},
        "executor": {"type": "string", "minLength": 1},
        "tool": {"type": "string", "minLength": 1},
        "inputs": {"type": "array", "items": {"type": "string"}},
        "expected_outputs": {"type": "array", "items": {"type": "string"}},
        "rollback": {
          "type": "object",
          "required": ["available", "procedure"],
          "properties": {
            "available": {"type": "boolean"},
            "procedure": {"type": "string"}
          },
          "additionalProperties": false
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
