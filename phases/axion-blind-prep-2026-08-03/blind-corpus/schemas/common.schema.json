{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:axion-protocol:schema:common:0.1.0",
  "title": "Axion Protocol common metadata",
  "$defs": {
    "metadata": {
      "type": "object",
      "required": [
        "identifier",
        "version",
        "date",
        "provenance",
        "status",
        "owner",
        "risk",
        "evidence",
        "approval"
      ],
      "properties": {
        "identifier": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "provenance": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "risk": {
          "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
        },
        "evidence": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            {
              "type": "object"
            }
          ]
        },
        "approval": {
          "type": "object",
          "required": ["required", "state"],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "state": {
              "enum": ["NOT_REQUIRED", "WAITING", "APPROVED", "REJECTED"]
            },
            "approved_by": {
              "type": ["string", "null"]
            },
            "approved_at": {
              "type": ["string", "null"],
              "format": "date-time"
            }
          },
          "additionalProperties": false
        }
      }
    }
  }
}
